{
	"name": "vite-preact-template",
	"description": "Plantilla base personal: Preact + Signals + Hono + Cloudflare Workers",
	"dependencies": {
		"@preact/signals": "^2.11.0",
		"hono": "4.11.1",
		"preact": "^10.29.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@cloudflare/vite-plugin": "1.51.3",
		"@preact/preset-vite": "^2.10.6",
		"@types/node": "^26.2.0",
		"typescript": "6.0.3",
		"vite": "^8.2.1",
		"wrangler": "4.121.0"
	},
	"private": true,
	"scripts": {
		"prepare": "pnpm run cf-typegen",
		"cf-typegen": "wrangler types",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"check": "tsc -b && vite build && pnpm exec wrangler deploy --dry-run",
		"deploy": "pnpm run build && pnpm exec wrangler deploy",
		"preview": "pnpm run build && vite preview",
		"lint": "biome check .",
		"write": "biome check --write ."
	},
	"type": "module"
}
